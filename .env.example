# Copy to .env (gitignored) and fill in locally. Never commit real keys.
TAVILY_API_KEY=

# Paid calls are refused unless BOTH of these are set. Amounts are USD.
NEMO_PAID_CALLS_ENABLED=false
NEMO_MAX_USD_PER_RUN=
# Optional calendar-month cap shared across runs (needs the spend ledger in data/nemo.sqlite).
NEMO_MONTHLY_USD_CAP=
